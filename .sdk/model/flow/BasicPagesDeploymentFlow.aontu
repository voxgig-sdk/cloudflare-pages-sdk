# BasicPagesDeploymentFlow

main: kit: flow: BasicPagesDeploymentFlow:
{
  entity: "pages_deployment",
  kind: "basic",
  name: "BasicPagesDeploymentFlow",
  step: [
    {
      i: {
        ref: "pages_deployment_ref01"
      }

      m: {
        account_id: "account01",
        deployment_id: "deployment01",
        project_id: "project01",
        project_name: "project_name01"
      }

      o: "create"
    }

    {
      m: {
        account_id: "account01",
        deployment_id: "deployment01",
        project_id: "project01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "pages_deployment_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "pages_deployment_ref01",
        srcdatavar: "pages_deployment_ref01_data",
        suffix: "_dt0"
      }

      m: {
        account_id: "account01",
        id: "pages_deployment01",
        project_id: "project01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-pages_deployment_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "pages_deployment_ref01",
        suffix: "_rm0"
      }

      m: {
        account_id: "account01",
        id: "pages_deployment01",
        project_id: "project01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        account_id: "account01",
        deployment_id: "deployment01",
        project_id: "project01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "pages_deployment_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPagesDeploymentFlow"
}